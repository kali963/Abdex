# AbdEX production settings. Copy to .env.production (never commit it), fill in, keep a copy in a safe place.
# Values marked (gen) come from ./generate-secrets.sh. Full guide: docs/launch.md

# --- domains (DNS A records of both point to this server) ---
SITE_DOMAIN=abdex.kz
ADMIN_DOMAIN=admin.abdex.kz
ACME_EMAIL=it@abdex.kz
PUBLIC_BASE_URL=https://abdex.kz
ADMIN_HOST=admin.abdex.kz

# --- secrets (gen) ---
SECRET_KEY=
FIELD_INDEX_KEY=
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
METRICS_TOKEN=
BACKUP_PASSPHRASE=

# --- capacity: uvicorn processes in the app container (≈ 2 × CPU cores) ---
WEB_CONCURRENCY=4
# database connections per process (request threads are limited to match); keep
# WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + 30 below PostgreSQL max_connections (200 in the stack)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15

# --- SMS (required: registration and sign-in codes). One of: ---
# Mobizon.kz
MOBIZON_API_KEY=
# SMSC.kz
# SMSC_LOGIN=
# SMSC_PASSWORD=
# any HTTPS gateway taking {"to","text"}
# SMS_GATEWAY_URL=
# SMS_GATEWAY_TOKEN=
# alpha name registered with the provider (optional)
SMS_SENDER=AbdEX

# --- e-mail (invoices, acts, password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AbdEX <no-reply@abdex.kz>

# --- e-signature: NCANode runs inside the stack; eGov mobile QR (see docs/eds-setup.md) ---
# sigex  — eGov mobile / eGov Business at once, through the SIGEX QR-signing API (no Smart Bridge registration)
# direct — the site's own mgovSign endpoints, after the Smart Bridge registration of the QR-signing service
EGOV_PROVIDER=sigex
EGOV_ORG_NAME=AbdEX
EGOV_ORG_BIN=

# --- online payments (only if the "online_payments" flag is switched on) ---
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- optional ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# VAPID_PRIVATE_KEY=          browser push: an EC P-256 private key in PEM ("\n" allowed)
VAPID_SUBJECT=mailto:support@abdex.kz
FX_RATES_URL=https://nationalbank.kz/rss/get_rates.cfm
# ESF_GATEWAY_URL=            sending ESF to IS ESF (flag gov.esf)
# ESF_GATEWAY_TOKEN=
# OCR_SERVICE_URL=            recognition of scanned documents
# ANALYTICS_DATABASE_URL=     read replica for reports

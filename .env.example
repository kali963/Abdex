# Copy to .env and fill in. Never commit .env (NFR-ARC-06).
APP_ENV=development                 # development | production
SECRET_KEY=                         # required in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg://abdex:abdex@db:5432/abdex
STORAGE_DIR=/data/storage           # S3-compatible storage in production (see docs/architecture.md)
ADMIN_HOST=                         # e.g. admin.abdex.kz — admin interface only on this host (FR-ACL-04)
SECURE_COOKIES=false                # forced to true in production
TRUST_PROXY=false                   # true only behind a reverse proxy that overwrites X-Forwarded-For
REQUIRE_2FA_PRIVILEGED=false        # forced to true in production (SEC-AUT-05)
RUN_BACKGROUND_WORKER=true          # false when the separate worker container runs
SEED_DEMO_DATA=true                 # demo accounts; forced off in production unless set explicitly
DEFAULT_LOCALE=ru
DEFAULT_TIMEZONE=Asia/Almaty
MAX_UPLOAD_MB=15
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=             # secret_token for setWebhook -> POST /hooks/telegram
# NFR-OBS-01: bearer token for /metrics (empty = endpoint disabled)
METRICS_TOKEN=

# NFR-DB-08 / SEC-DAT-03: field encryption keys come from the secret store (mounted file), never from code.
# File format: "1:<base64 32 bytes>,2:<base64 32 bytes>" — the highest version encrypts, all versions decrypt.
# Rotate: add a new version, restart, run `python -m app.cli rotate-keys`, then remove the old version.
# FIELD_ENCRYPTION_KEYS_FILE=/run/secrets/abdex_field_keys   (required in production)
# Separate key for blind indexes (equality search over encrypted IIN / IBAN); not rotated with the field keys.
# FIELD_INDEX_KEY=

# Section 50: qualified e-signature verification service (NCANode). Empty = test CA, development only.
EDS_NCANODE_URL=
# FR-BIL-06: hosted checkout of the payment provider. Empty = simulator, development only.
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=              # HMAC secret of callbacks to POST /hooks/payments (required in production)
PUBLIC_BASE_URL=http://localhost:8000  # used for provider return and callback URLs
# FR-LOC-04: official exchange rates feed of the National Bank (empty: test rates in development, manual in production)
FX_RATES_URL=https://nationalbank.kz/rss/get_rates.cfm
# FR-MOB-02 Web Push: VAPID key pair from the secret store (PEM, "\n" allowed); subject is a contact for push services
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@abdex.kz
# Notification transports (empty = development outbox only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AbdEX <no-reply@abdex.kz>
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Behind reverse proxies: how many of them append to X-Forwarded-For (TRUST_PROXY=true)
TRUSTED_PROXY_HOPS=1

# M6 document recognition: external OCR service for scans without a text layer (optional)
# OCR_SERVICE_URL=
# OCR_SERVICE_TOKEN=
# FR-BIL-07 ESF sending gateway (simulator when empty; flag gov.esf)
# ESF_GATEWAY_URL=
# ESF_GATEWAY_TOKEN=
# M15-06 read replica for analytics and KPI (main database when empty)
# ANALYTICS_DATABASE_URL=
